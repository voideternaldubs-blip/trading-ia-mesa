{
  "buildCommand": "",
  "installCommand": "",
  "framework": null,
  "outputDirectory": "site",
  "cleanUrls": true,
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- site/index.html site/aranha.html site/vivo.html site/predio.html vercel.json",
  "headers": [
    {
      "source": "/dados/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "dados": false
    }
  }
}